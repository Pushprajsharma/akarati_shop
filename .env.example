# MongoDB Atlas connection string or local replica-set URI
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=khata_app

# Admin login credentials (change these before running)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisToALongUniquePassword

# Generate a random secret of at least 32 characters
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Public site origin, e.g. http://localhost:3000
APP_URL=http://localhost:3000
